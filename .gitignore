# Byte-compiled / optimized Python
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
.venv
env/
venv/
ENV/

# Build / distribution artifacts
build/
*.egg-info/
*.egg
.eggs/

# Installer / offline wheel cache (local only, do not commit)
wheels/

# Packaging / lint / test caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environment / secrets
.env
.env.local
*.pem
*.key

# OS / editor files
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
*.swo

# Local working notes (do not publish)
todo.md
future-todo.md
v2/tools-pack/out/
v2/bundle/out/

# Class bundle: the compressed archive is too large for git, and the
# unpacked staging directory is just its contents
dist/*.tar.gz
dist/*/
